# Server
PORT=8080
ENV=development
APP_VERSION=0.1.0
LOG_LEVEL=debug

# CORS — comma-separated origins. Use * only without credentials.
CORS_ALLOWED_ORIGINS=*
CORS_ALLOW_CREDENTIALS=false

# Host ports published by docker compose (change if another project already binds them)
POSTGRES_HOST_PORT=5432
REDIS_HOST_PORT=6380
MINIO_API_HOST_PORT=9010
MINIO_CONSOLE_HOST_PORT=9011

# Postgres (used by /ready and later stages)
DATABASE_URL=postgres://asnakech:asnakech@localhost:5432/asnakech?sslmode=disable

# Redis — host port must match REDIS_HOST_PORT above when API runs on the host
REDIS_URL=redis://localhost:6380/0

# Auth (required when ENV=production)
JWT_SECRET=dev-only-change-me
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=168h

# Object storage (MinIO locally) — host ports must match MINIO_*_HOST_PORT
S3_ENDPOINT=http://localhost:9010
S3_REGION=us-east-1
S3_BUCKET=asnakech
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_USE_PATH_STYLE=true
# Optional CDN / public base (defaults to endpoint/bucket path-style)
# S3_PUBLIC_BASE_URL=https://cdn.example.com/asnakech
MEDIA_PRESIGN_TTL=15m

# Live learning (Stage 15)
LIVE_DEFAULT_PROVIDER=custom
LIVE_JITSI_BASE_URL=https://meet.jit.si

# Payments (Stage 18)
PAYMENT_DEFAULT_PROVIDER=manual
# PAYMENT_WEBHOOK_SECRET=dev-webhook-secret
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
# CHAPA_SECRET_KEY=
# CHAPA_WEBHOOK_SECRET=
