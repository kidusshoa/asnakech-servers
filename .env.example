# Server
PORT=8080
ENV=development
APP_VERSION=0.1.0
LOG_LEVEL=debug

# CORS — comma-separated origins. Use * only without credentials.
CORS_ALLOWED_ORIGINS=*
CORS_ALLOW_CREDENTIALS=false

# Postgres (used by /ready and later stages)
DATABASE_URL=postgres://asnakech:asnakech@localhost:5432/asnakech?sslmode=disable

# Redis
REDIS_URL=redis://localhost:6379/0

# Auth (required when ENV=production)
JWT_SECRET=dev-only-change-me
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=168h

# Object storage (MinIO locally)
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=asnakech
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_USE_PATH_STYLE=true
